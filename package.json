{
  "name": "whatsmail",
  "version": "1.0.0",
  "description": "WhatsMail desktop companion",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.18",
    "nodemailer": "^7.0.6",
    "qrcode": "^1.5.4",
    "firebase": "^12.4.0"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.whatsmail.desktop",
    "productName": "WhatsMail",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "WhatsMail-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
